{
  "version": 2,
  "window": {
    "title": "CloudUI Hello",
    "size": [520, 260],
    "decorations": "none",
    "caption_height": 36,
    "corner_radius": 12
  },
  "page": {
    "layout": { "direction": "column", "gap": 12, "padding": 16 },
    "children": [
      { "type": "label", "text": "这是一个直接跑在 cloud-ui 上的独立窗口。", "style": "muted" },
      { "type": "spacer", "height": 12 },
      {
        "type": "stem",
        "layout": { "direction": "row", "gap": 12 },
        "children": [
          { "type": "text_button", "name": "hello", "text": "消息对话框" },
          { "type": "text_button", "name": "theme", "text": "{{theme_label}}" }
        ]
      }
    ]
  }
}
